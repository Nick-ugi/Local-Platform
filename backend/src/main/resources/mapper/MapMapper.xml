<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.queenstownlocal.backend.map.MapMapper">

	<!--
		The box query of docs/05-erd.md section 8. The box is compared as a flat longitude/latitude
		rectangle (geometry), which is what a map viewport is. As a geography its edges would follow
		the globe, and a box wider than 180 degrees would cover the other side of the world.
		ST_MakeEnvelope takes (west, south, east, north).
	-->
	<select id="findPlaceMarkers" resultType="com.queenstownlocal.backend.map.PlaceMarker">
		SELECT 'place' AS kind, slug,
		       ST_Y(location::geometry) AS latitude,
		       ST_X(location::geometry) AS longitude,
		       name, category, subtype
		FROM place
		WHERE status = 'public'
		  AND ST_Intersects(location::geometry, ST_MakeEnvelope(#{west}, #{south}, #{east}, #{north}, 4326))
		<if test="!categories.isEmpty()">
		  AND category IN
		  <foreach collection="categories" item="category" open="(" separator=", " close=")">#{category}</foreach>
		</if>
		ORDER BY id
		LIMIT #{limit}
	</select>

</mapper>
