API_BASE_URL=http://localhost:8080
# Mapbox public token (starts with pk.). Put the value in .env.local, never here.
NEXT_PUBLIC_MAPBOX_TOKEN=
# The public address of the site, used for canonical links and og:url.
SITE_URL=http://localhost:3001
# The operator's email for Privacy Policy, Terms and "Suggest an edit". Without it those pages point
# to the project's GitHub Issues and places have no "Suggest an edit" link.
CONTACT_EMAIL=
