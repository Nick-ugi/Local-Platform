# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# The three addresses. Each needs a DNS A record pointing at the server.
WEB_HOST=queenstownlocal.example
ADMIN_HOST=admin.queenstownlocal.example
API_HOST=api.queenstownlocal.example

# The email Let's Encrypt writes to about the certificates. For a local check on *.localhost, use
#   WEB_HOST=web.localhost ADMIN_HOST=admin.localhost API_HOST=api.localhost TLS_MODE=internal
TLS_MODE=you@example.com

# Make each with: openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=

# The Mapbox public token (pk.). Restrict it to the web and admin addresses in the Mapbox account.
MAPBOX_TOKEN=

# The operator's email for Privacy Policy, Terms and "Suggest an edit". Optional.
CONTACT_EMAIL=
